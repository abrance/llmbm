# llmbm api 镜像：多阶段，只带生产依赖
# 构建上下文是仓库根（npm workspaces 需要根 lockfile）
FROM node:24-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY packages/core/package.json packages/core/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @llmbm/core --workspace @llmbm/api --include-workspace-root

COPY packages/core packages/core
COPY apps/api apps/api
RUN npm run build -w @llmbm/core && npm run build -w @llmbm/api

# 只留生产依赖
RUN npm prune --omit=dev

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8787 \
    HOST=0.0.0.0 \
    LLMBM_DB=/data/llmbm.db
# 非 root 运行
RUN addgroup -S app && adduser -S app -G app && mkdir -p /data && chown -R app:app /data
COPY --from=build --chown=app:app /repo/node_modules ./node_modules
COPY --from=build --chown=app:app /repo/packages/core/package.json ./packages/core/
COPY --from=build --chown=app:app /repo/packages/core/dist ./packages/core/dist
COPY --from=build --chown=app:app /repo/apps/api/package.json ./apps/api/
COPY --from=build --chown=app:app /repo/apps/api/dist ./apps/api/dist
COPY --from=build --chown=app:app /repo/package.json ./package.json
USER app
EXPOSE 8787
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD node -e "fetch('http://127.0.0.1:8787/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/server.js"]
